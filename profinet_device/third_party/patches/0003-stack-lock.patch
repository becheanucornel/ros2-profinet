+static pthread_mutex_t stack_mutex;
+static pthread_once_t stack_once = PTHREAD_ONCE_INIT;
+
+static void stack_mutex_init (void)
+{
+   pthread_mutexattr_t attr;
+
+   pthread_mutexattr_init (&attr);
+   pthread_mutexattr_settype (&attr, PTHREAD_MUTEX_RECURSIVE);
+   pthread_mutexattr_setprotocol (&attr, PTHREAD_PRIO_INHERIT);
+   pthread_mutex_init (&stack_mutex, &attr);
+}
+
+void pnal_lock (void)
+{
+   pthread_once (&stack_once, stack_mutex_init);
+   pthread_mutex_lock (&stack_mutex);
+}
+
+void pnal_unlock (void)
+{
+   pthread_mutex_unlock (&stack_mutex);
+}
