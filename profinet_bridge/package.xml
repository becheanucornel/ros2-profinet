<?xml version="1.0"?>
<package format="3">
  <name>profinet_bridge</name>
  <version>0.1.0</version>
  <description>Maps ROS 2 topics to the modules of a PROFINET IO device, as an XML file says.</description>
  <maintainer email="becheanucornel28@gmail.com">Becheanu Cornel-Constantin</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/becheanucornel/ros2-profinet</url>
  <url type="bugtracker">https://github.com/becheanucornel/ros2-profinet/issues</url>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
